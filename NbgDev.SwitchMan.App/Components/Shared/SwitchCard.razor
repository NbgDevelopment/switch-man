<div class="card mb-3 switch-card">
    <div class="card-body">
        <div class="switch-card-header">
            <div class="switch-card-info">
                <h5 class="card-title mb-1">@Switch.Name</h5>
                <p class="card-text text-muted mb-0">
                    <span class="bi bi-hdd-network me-1"></span>
                    @Switch.IpAddress
                </p>
            </div>
        </div>
        <div class="switch-ports mt-3">
            @if (_isLoading)
            {
                <p class="text-muted mb-0"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Loading ports...</p>
            }
            else if (_loadError is not null)
            {
                <p class="text-danger mb-0"><span class="bi bi-exclamation-triangle me-1"></span>@_loadError</p>
            }
            else if (_ports is not null && _ports.Any())
            {
                <table class="table table-sm table-bordered mb-0 port-table">
                    <thead>
                        <tr>
                            <th scope="col">Port</th>
                            <th scope="col">VLAN</th>
                            <th scope="col">New VLAN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var port in _ports)
                        {
                            <tr>
                                <td>@port.PortNumber@(string.IsNullOrEmpty(port.PortName) ? "" : $" - {port.PortName}")</td>
                                <td>@port.VlanId (@port.VlanName)</td>
                                <td>
                                    <select class="form-select form-select-sm"
                                            @bind="_selectedVlans[port.PortNumber]"
                                            @bind:after="() => OnVlanSelectionChangedAsync(port)">
                                        <option value="">-- Select --</option>
                                        @if (_vlans is not null)
                                        {
                                            @foreach (var vlan in _vlans)
                                            {
                                                <option value="@vlan.Id">@vlan.Name</option>
                                            }
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">No port information available.</p>
            }
        </div>
        <div class="switch-card-actions mt-3">
            <button class="btn btn-outline-secondary switch-action-btn" @onclick="OnMoveUp" title="Move Up" aria-label="Move Up">
                <span class="bi bi-arrow-up"></span>
                <span class="btn-label">Up</span>
            </button>
            <button class="btn btn-outline-secondary switch-action-btn" @onclick="OnMoveDown" title="Move Down" aria-label="Move Down">
                <span class="bi bi-arrow-down"></span>
                <span class="btn-label">Down</span>
            </button>
            <button class="btn btn-outline-danger switch-action-btn" @onclick="OnDelete" title="Delete" aria-label="Delete">
                <span class="bi bi-trash"></span>
                <span class="btn-label">Delete</span>
            </button>
        </div>
    </div>
</div>

